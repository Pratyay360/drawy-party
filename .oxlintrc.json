{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "rules": {
        "no-console": "warn",
        "no-unused-vars": "warn",
        "typescript/no-explicit-any": "warn",
        "typescript/no-unused-vars": "warn"
    },
    "overrides": [
        {
            "files": ["src/routeTree.gen.ts", "src/polyfill.ts"],
